{
  "name": "clawcodex-web",
  "private": true,
  "version": "0.1.0",
  "description": "Browser client for ClawCodex — served by `clawcodex web` over the same gateway the desktop app uses.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5175",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@nanostores/react": "1.1.0",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "katex": "0.16.47",
    "marked": "18.0.9",
    "nanostores": "1.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "4.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
