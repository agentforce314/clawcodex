{
  "name": "ClawCodex",
  "short_name": "ClawCodex",
  "description": "Browser client for the ClawCodex agent.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#161e29",
  "theme_color": "#aa2c00",
  "icons": [
    {
      "src": "./favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./favicon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
